# What `gcloud builds submit` leaves out of the upload; the same as .dockerignore, so
# secrets, local data and tooling never leave this machine.
.env
.env.*
!.env.example
.git
.github
.vscode
.idea
.claude
venv
.venv
web/node_modules
web/dist
# The native app's sources and its Rust and Xcode builds (gigabytes); the server image
# does not use them.
web/src-tauri
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
/data_cache
/data
output
tests
*.md
!README.md
.DS_Store
