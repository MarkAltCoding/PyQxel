# Copy to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
# Financial Modeling Prep key; enables the fallback when yfinance fails.
FINANCIAL_DATA_API_KEY=
# SEC EDGAR requires a User-Agent naming you and a contact email, e.g.
# "PyQxel jane@example.com". Filings are skipped when unset.
SEC_USER_AGENT=
# R installation root, e.g. /Library/Frameworks/R.framework/Resources
R_HOME=
# Optional overrides for the AI layer.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# SEC_SECTION_MAX_CHARS=60000
