# Copy to .env and fill in real values. Never commit .env.
# Encrypts the provider keys accounts store; generate with
# python -m app.jobs.users generate-encryption-key, and keep it.
CREDENTIALS_ENCRYPTION_KEY=
# Your own Anthropic and Financial Modeling Prep keys. Never used to serve requests:
# python -m app.jobs.users create you@example.com --import-env-keys copies them into
# your own account, and every account pays with the keys it stores.
ANTHROPIC_API_KEY=
FINANCIAL_DATA_API_KEY=
# Development only: use yfinance when an account has no FMP key, or FMP fails or its plan
# does not cover a request. Leave off in production.
# YFINANCE_FALLBACK=true
# Requests each account may make per minute.
# RATE_LIMIT_PER_MINUTE=120
# SEC EDGAR requires a User-Agent naming you and a contact email, e.g.
# "PyQxel jane@example.com". Filings and fundamentals are skipped when unset.
SEC_USER_AGENT=
# R installation root, e.g. /Library/Frameworks/R.framework/Resources
R_HOME=
# Where backtests, analyses, simulations and the screened universe are stored. Defaults
# to SQLite at data_cache/pyqxel.db; for Postgres use postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=postgresql+asyncpg://localhost/pyqxel
# Redis for caching market data across requests and workers; caching is off when unset.
# REDIS_URL=redis://localhost:6379/0
# How long a stored AI analysis is reused instead of paying for a new one, in seconds
# (default 24 hours); 0 always writes a new one. Works without Redis.
# ANALYSIS_CACHE_TTL_SECONDS=86400
# Baseline filter for the screened universe (python -m app.jobs.screener), and how often
# its financials are rebuilt from the SEC's 1.3 GB bulk archive.
# SCREENER_MIN_MARKET_CAP=50000000
# SCREENER_MIN_DOLLAR_VOLUME=1000000
# SCREENER_MIN_PRICE=2
# SCREENER_FUNDAMENTALS_REFRESH_DAYS=7
# Optional overrides for the AI layer.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# SEC_SECTION_MAX_CHARS=60000
