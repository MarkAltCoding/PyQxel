# ── Environment / secrets (NEVER commit — holds the Anthropic API key) ──
.env
.env.local
.env.*.local

# ── Python ──
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ── R ──
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# ── Data / pipeline outputs ──
data/raw/
data/processed/
output/
*.parquet
!tests/fixtures/*.parquet
# Default SQLite results database and its journal files.
data_cache/pyqxel.db*

# ── OS junk ──
.DS_Store
Thumbs.db

# ── IDE (settings.json + extensions.json ARE committed on purpose) ──
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ── Claude Code local settings (personal permissions — workflows/ IS committed) ──
.claude/settings.local.json

# ── Local-only docs (personal/internal — keep out of the public repo) ──
SETUP_BRIEFING.md

