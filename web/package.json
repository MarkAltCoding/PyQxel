{
  "name": "pyqxel-web",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc -b && vite build",
    "vendor": "npm run pyodide && npm run clang",
    "pyodide": "node scripts/vendor-pyodide.mjs",
    "clang": "node scripts/vendor-clang.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen:api": "npx --yes openapi-typescript@7.13.0 openapi.json --default-non-nullable=false -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "^5.104.2",
    "@yowasp/clang": "22.0.0-git20542-10",
    "echarts": "^6.1.0",
    "pyodide": "314.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
