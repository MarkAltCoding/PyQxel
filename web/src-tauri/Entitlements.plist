<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS app's entitlements: the App Sandbox the Mac App Store requires, and the least
  it needs inside it. It connects out to the PyQxel server and nothing else, and saves
  the files people download (a prompt to paste into Claude) to their Downloads folder.
  The web view's own processes run JavaScript and WebAssembly, so the app needs no JIT
  entitlement of its own. Opening the system browser to sign in, and being opened by a
  pyqxel:// link, need none.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
